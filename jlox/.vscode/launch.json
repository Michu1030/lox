{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "GenerateAst",
            "request": "launch",
            "mainClass": "tool.GenerateAst",
            "cwd": "${workspaceFolder}",
            "args": ["src/jlox"]
        },

        {
            "type": "java",
            "name": "PrettyPrint",
            "request": "launch",
            "mainClass": "jlox.AstPrinter"
        },

        {
            "type": "java",
            "name": "REPL",
            "request": "launch",
            "mainClass": "jlox.Lox",
        },

        {
            "type": "java",
            "name": "Run",
            "request": "launch",
            "mainClass": "jlox.Lox",
            "cwd": "${workspaceFolder}",
            "args": ["main.jlox"]
        }
    ]
}